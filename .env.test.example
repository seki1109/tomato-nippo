# テスト用DB（本番DBとは別のテスト専用DB）
# このファイルをコピーして .env.test を作成し、実際の接続情報を入力してください:
#   cp .env.test.example .env.test
#
# テストDBのセットアップ手順:
#   1. MySQL root で scripts/setup-test-db.sql を実行してDBとユーザー権限を設定
#      mysql -u root -p < scripts/setup-test-db.sql
#   2. マイグレーションを実行
#      npm run db:test-migrate
#   3. APIテストを実行
#      npm run test:api
DATABASE_URL="mysql://tomato_user:YOUR_PASSWORD@localhost:3306/tomato_nippo_test"
SHADOW_DATABASE_URL="mysql://tomato_user:YOUR_PASSWORD@localhost:3306/tomato_nippo_shadow"

# JWT（テスト用固定シークレット）
JWT_SECRET="test-secret-key-for-testing-only"
JWT_EXPIRES_IN="7d"
